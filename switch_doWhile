void main() {
  int days = 0;
  switch (days) {
    case 0:
      print("Sunday");
    case 1:
      print("Monday");
    case 2:
      print("Tuesday");
    case 3:
      print("Wednesday");
    case 4:
      print("Thursday");
    case 5:
      print("Friday");
    case 6:
      print("Saturday");
    default:
      print("Invalid day");
  }

  ///Do While
  int i = 3;
  do {
    print(i);
    i++;
  } while (i < 7);
}
